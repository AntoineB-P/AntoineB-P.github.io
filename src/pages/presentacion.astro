---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';


<BaseLayout title={'Presentación - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="presentacion">

      <!-- HEADER -->
      <section class="header">
        <span class="eyebrow">Primera entrega · Bases de Datos 1</span>
        <h1>Presentación</h1>

        <div class="perfil">
          <img
            src="/images/portada.jpeg"
            alt="Foto de Antoine Blanco Palacio"
            class="avatar"
          />
          <div class="perfil-info">
            <h2>Antoine Blanco Palacio</h2>
            <p class="materia">Bases de Datos 1 · Semestre 2026 · Universidad El Bosque</p>
          </div>
        </div>
      </section>

  
      <section class="video-section">
        <h2 class="section-label">Video de presentación</h2>
        <div class="video-frame">
          <div class="video-wrapper">
            <iframe
              src="https://www.youtube.com/embed/qbkLyOmoYbM"
              title="Video de presentación"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="why-section">
        <h2 class="section-label">¿Por qué Bases de Datos 1?</h2>
        <p class="why-text">
          Ya he trabajado en proyectos como <strong>Code Translate</strong> y
          <strong>RapiSend</strong>, conectando Angular con Spring Boot, y ahí entendí
          algo clave: no importa qué tan pulida esté una interfaz — si la base de datos
          detrás está mal modelada, todo el sistema se vuelve frágil. Como también hago
          desarrollo freelance por mi cuenta, sé que esos errores no solo afectan una
          nota, afectan a un cliente real.
        </p>
      </section>

      <section class="quote-section">
        <span class="quote-mark">"</span>
        <p class="quote-text">
          Este semestre quiero ir más allá del pénsum: quiero demostrar dominio real
          de Bases de Datos 1 y empezar a usarla como una herramienta profesional que
          aplico en mi día a día, no solo como una materia que apruebo.
        </p>
      </section>

    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .presentacion {
    max-width: 720px;
    padding: 1rem 0 3rem;
  }

  section {
    margin-bottom: 3rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .header h1 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .section-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: 1.25rem;
  }

  .perfil {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
  }

  .avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
    border: 2px solid var(--border-color);
    flex-shrink: 0;
  }

  .perfil-info h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .materia {
    color: var(--text-secondary);
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .video-frame {
    display: flex;
    justify-content: center;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }


  .why-text {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 1rem;
  }

  .why-text strong {
    color: var(--text-primary);
  }
  .quote-section {
    position: relative;
    padding: 2rem 1.5rem 2rem 3rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 16px 16px 0;
  }

  .quote-mark {
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    font-size: 3rem;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.35;
    font-family: Georgia, serif;
  }

  .quote-text {
    font-size: 1.25rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--text-primary);
    margin: 0;
  }

  @media (max-width: 600px) {
    .header h1 {
      font-size: 2rem;
    }

    .perfil {
      flex-direction: column;
      text-align: center;
    }

    .facts-grid {
      grid-template-columns: 1fr;
    }

    .quote-text {
      font-size: 1.05rem;
    }
  }
</style>
