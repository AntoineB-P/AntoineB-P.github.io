---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
---

<BaseLayout title={'Presentación - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="presentacion">
      <h1>Presentación</h1>

      <div class="perfil">
        <img
          src="/images/foto-perfil.jpg"
          alt="Foto de Antoine Blanco Palacio"
          class="avatar"
        />
        <div class="perfil-info">
          <h2>Antoine Blanco Palacio</h2>
          <p class="materia">Bases de Datos 1 · Semestre 2026 · Universidad El Bosque</p>
        </div>
      </div>

      <h2>Video de presentación</h2>
      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/TU_ID_DE_VIDEO"
          title="Video de presentación"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <h2>Este semestre quiero demostrar que...</h2>
      <p>
        Escribe aquí tu frase final sobre lo que quieres lograr este semestre en Bases de Datos 1.
      </p>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .presentacion {
    max-width: 700px;
    padding: 2rem 0;
  }

  .perfil {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 1.5rem 0 2rem;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
  }

  .perfil-info h2 {
    margin: 0;
  }

  .materia {
    color: var(--text-secondary);
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 12px;
    overflow: hidden;
    margin: 1rem 0 2rem;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .presentacion h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .presentacion p {
    color: var(--text-secondary);
  }
</style>
