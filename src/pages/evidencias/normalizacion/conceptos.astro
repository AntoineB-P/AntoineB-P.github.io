  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  strong {
    color: var(--text-primary);
  }

  .lista-conceptos {
    color: var(--text-secondary);
    line-height: 1.8;
    padding-left: 1.25rem;
  }

  .lista-conceptos li {
    margin-bottom: 0.5rem;
  }

  .fuentes {
    color: var(--text-secondary);
    line-height: 1.9;
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }
</style>