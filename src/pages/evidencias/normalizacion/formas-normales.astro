---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

const formas = [
  { nombre: '1FN', regla: 'Cada celda con un solo valor.', solucion: 'Los valores repetidos van a filas o a otra tabla.' },
  { nombre: '2FN', regla: '1FN, y nada depende de solo una parte de la clave.', solucion: 'Lo que depende de una parte se va a otra tabla.' },
  { nombre: '3FN', regla: '2FN, y nada depende de otro atributo que no es clave.', solucion: 'Se crea una tabla para ese atributo intermedio.' },
  { nombre: 'FNBC', regla: '3FN, y todo determinante es clave candidata.', solucion: 'El determinante que no es clave se va a su propia tabla.' },
  { nombre: '4FN', regla: 'FNBC, sin multivaluados independientes.', solucion: 'Cada multivaluado en su tabla.' },
  { nombre: '5FN', regla: '4FN, y no se puede partir más sin perder datos.', solucion: 'Tablas pequeñas que al unirlas dan la original.' },
  { nombre: '6FN', regla: 'Cada tabla: la clave y un solo atributo.', solucion: 'Casi nunca se usa; es de data warehouses.' },
];
---

<BaseLayout title={'Formas normales - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">

      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Normalización</span>
      <h1>Formas normales</h1>

      <p class="intro">
        Son reglas en escalera: para cumplir una hay que cumplir la anterior. En
        la práctica casi todo se queda en 3FN o FNBC.
      </p>

      <div class="formas">
        {formas.map(f => (
          <div class="forma">
            <span class="forma-nombre">{f.nombre}</span>
            <div class="forma-content">
              <p><strong>Regla:</strong> {f.regla}</p>
              <p><strong>Cómo se resuelve:</strong> {f.solucion}</p>
            </div>
          </div>
        ))}
      </div>

      <section class="bitacora">
        <div class="bitacora-fila">
          <span class="bitacora-label">En clase</span>
          <p>El profe las explicó una por una.</p>
        </div>
        <div class="bitacora-fila">
          <span class="bitacora-label">Lo que aprendí</span>
          <p>
            Lo que más me costó fue hallar las dependencias y la llave
            primaria de cada tabla, porque de eso depende saber en qué forma
            normal está. También entendí que las formas normales van en escalera:
            no se puede saltar a 3FN sin pasar por 2FN. En el <a href="/evidencias/proyecto/modelos">proyecto</a> llegamos hasta 3FN, y en el <a href="/evidencias/normalizacion/taller-babel">taller Babel</a> hasta BCNF.
          </p>
        </div>
      </section>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        <li><a href="https://es.wikipedia.org/wiki/Tercera_forma_normal" target="_blank" rel="noopener">Wikipedia — Tercera forma normal</a></li>
        <li><a href="https://es.wikipedia.org/wiki/Forma_normal_de_Boyce-Codd" target="_blank" rel="noopener">Wikipedia — Forma normal de Boyce-Codd</a></li>
      </ul>

    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 720px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .formas {
    display: flex;
    flex-direction: column;
  }

  .forma {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .forma-nombre {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .forma-content p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }

  .forma-content p:last-child {
    margin-bottom: 0;
  }

  .forma-content strong {
    color: var(--text-primary);
  }

  h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }

  .fuentes {
    color: var(--text-secondary);
    line-height: 1.9;
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .forma {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  .bitacora {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-color);
  }

  .bitacora-fila {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .bitacora-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.2rem;
  }

  .bitacora-fila p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .bitacora-fila {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>