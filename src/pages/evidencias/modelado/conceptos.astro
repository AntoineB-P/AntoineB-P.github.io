---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';
---

<BaseLayout title={'Conceptos - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">
      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Modelado · 01</span>
      <h1>Conceptos</h1>

      <dl class="definiciones">
        <div class="def">
          <dt>Gestor de BD (SGBD)</dt>
          <dd>El software que está entre el usuario y los datos. Toda consulta pasa por él; nadie toca los archivos directo.</dd>
        </div>
        <div class="def">
          <dt>Atributo</dt>
          <dd>Una característica de una entidad. JUGADOR tiene nombre, edad y dorsal.</dd>
        </div>
        <div class="def">
          <dt>Cardinalidad</dt>
          <dd>Cuántas veces participa una entidad en una relación, como (mínimo, máximo). Define si es 1:1, 1:N o N:M.</dd>
        </div>
        <div class="def">
          <dt>Clave primaria</dt>
          <dd>Lo que identifica a cada registro. No se repite ni queda vacía.</dd>
        </div>
        <div class="def">
          <dt>Multivaluado</dt>
          <dd>Un atributo con varios valores, como los teléfonos de una persona.</dd>
        </div>
        <div class="def">
          <dt>Derivado</dt>
          <dd>Se calcula a partir de otro, como la edad desde la fecha de nacimiento.</dd>
        </div>
        <div class="def">
          <dt>BD relacional</dt>
          <dd>Guarda todo en tablas, y las tablas se relacionan por sus claves.</dd>
        </div>
      </dl>

      <h2>Segundo MER: vuelos</h2>
      <img src="/images/mer-vuelos.png" alt="Modelo entidad-relación de vuelos, con avión, piloto, tripulación y vuelo" class="img-doc" />

      <section class="bitacora">
        <div class="bitacora-fila">
          <span class="bitacora-label">En clase</span>
          <p>
            El profe explicó estos conceptos. El MER de vuelos fue mi segundo
            modelo, después del <a href="/evidencias/modelado-torneo">MER del torneo</a>.
          </p>
        </div>
        <div class="bitacora-fila">
          <span class="bitacora-label">Lo que aprendí</span>
          <p>
            El atributo derivado me confundió al inicio, pero lo que más me
            costó fue leer las cardinalidades.
          </p>
        </div>
      </section>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        <li><a href="https://es.wikipedia.org/wiki/Sistema_de_gestión_de_bases_de_datos" target="_blank" rel="noopener">Wikipedia — Sistema de gestión de bases de datos</a></li>
        <li><a href="https://es.wikipedia.org/wiki/Modelo_entidad-relación" target="_blank" rel="noopener">Wikipedia — Modelo entidad-relación</a></li>
      </ul>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 700px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

    .img-doc {
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    margin: 1rem 0;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  strong {
    color: var(--text-primary);
  }

  .fuentes {
    color: var(--text-secondary);
    line-height: 1.9;
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }

  .bitacora {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-color);
  }

  .bitacora-fila {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .bitacora-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.2rem;
  }

  .bitacora-fila p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .bitacora-fila {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
  .definiciones {
    margin: 0;
    border-top: 1px solid var(--border-color);
  }

  .def {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.25rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .def dt {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.92rem;
  }

  .def dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .def {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>