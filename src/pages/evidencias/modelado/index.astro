---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

const hoy = new Date().toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const temas = [
  { num: '01', titulo: 'Conceptos y fuentes', desc: 'Qué es un SGBD, atributos, cardinalidad, claves.', href: '/evidencias/modelado/conceptos' },
  { num: '02', titulo: 'MER extendido', desc: 'Generalización, especialización, exclusividad y participación.', href: '/evidencias/modelado/mer-extendido' },
  { num: '03', titulo: 'Transformación a tablas', desc: 'Pasos para pasar un MER al modelo relacional.', href: '/evidencias/modelado/transformacion-tablas' },
  { num: '04', titulo: 'Oracle Data Modeler', desc: 'Notación crowfoot y cómo se lee en la herramienta.', href: '/evidencias/modelado/oracle-data-modeler' },
  { num: '05', titulo: 'Tipos de datos', desc: 'Tipos de datos en bases de datos relacionales.', href: '/evidencias/modelado/tipos-de-datos' },
];
---

<BaseLayout title={'Modelado - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

    <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

    <span class="eyebrow">Bases de Datos 1</span>
    <h1>Modelado</h1>

    <div class="nota">
      <span class="nota-fecha">{hoy}</span>
      <p>
        No he subido evidencias de Modelado en el último mes. Voy a reunir aquí
        todos los conceptos que necesito tener claros — con fuentes confiables —
        antes de subir el resto del material completo.
      </p>
    </div>

    <section class="lista">
      {temas.map(t => (
        <a href={t.href} class="tema-row">
          <span class="tema-num">{t.num}</span>
          <span class="tema-titulo">{t.titulo}</span>
          <span class="tema-desc">{t.desc}</span>
          <span class="tema-arrow">→</span>
        </a>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .nota {
    padding: 1.25rem 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 14px 14px 0;
    margin-bottom: 2.5rem;
  }

  .nota-fecha {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin-bottom: 0.4rem;
  }

  .nota p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .lista {
    display: flex;
    flex-direction: column;
    padding-bottom: 3rem;
  }

  .tema-row {
    display: grid;
    grid-template-columns: 2.5rem 12rem 1fr 1.5rem;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }

  .tema-row:hover {
    padding-left: 0.6rem;
    color: var(--color-primary);
  }

  .tema-row:hover .tema-arrow {
    transform: translateX(4px);
  }

  .tema-num {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .tema-titulo {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .tema-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .tema-arrow {
    text-align: right;
    transition: transform 0.2s ease;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .tema-row {
      grid-template-columns: 2rem 1fr;
      grid-template-rows: auto auto;
    }

    .tema-desc {
      grid-column: 2;
    }

    .tema-arrow {
      display: none;
    }
  }
</style>