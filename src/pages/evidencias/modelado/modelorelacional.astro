---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';
---

<BaseLayout title={'Modelo relacional - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">
      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Modelado · 05</span>
      <h1>Modelo relacional</h1>

      <h2>ACID</h2>
      <dl class="definiciones">
        <div class="def"><dt>Atomicidad</dt><dd>La transacción se hace completa o no se hace.</dd></div>
        <div class="def"><dt>Consistencia</dt><dd>La base pasa de un estado válido a otro.</dd></div>
        <div class="def"><dt>Aislamiento</dt><dd>Una transacción no se mete con otra.</dd></div>
        <div class="def"><dt>Durabilidad</dt><dd>Lo confirmado queda guardado aunque el sistema falle.</dd></div>
      </dl>

      <h2>Claves</h2>
      <dl class="definiciones">
        <div class="def"><dt>Superclave</dt><dd>Atributos que identifican una fila, aunque sobre alguno.</dd></div>
        <div class="def"><dt>Clave candidata</dt><dd>Una superclave mínima: no se le puede quitar nada.</dd></div>
        <div class="def"><dt>Clave primaria</dt><dd>La candidata que se escoge como oficial.</dd></div>
      </dl>

      <h2>Del lógico al relacional</h2>
      <p>
        El mismo ejercicio de <a href="/evidencias/modelado/oracle-data-modeler">Data Modeler</a> ya como tablas: P es PK, F es FK y * es obligatorio.
      </p>
      <img src="/images/Oracle2.png" alt="Modelo relacional del ejercicio en Oracle Data Modeler" class="img-doc" />

      <section class="bitacora">
        <div class="bitacora-fila">
          <span class="bitacora-label">En clase</span>
          <p>Pasamos al relacional el modelo lógico que hicimos en grupo.</p>
        </div>
        <div class="bitacora-fila">
          <span class="bitacora-label">Lo que aprendí</span>
          <p>Cómo un dibujo se vuelve tablas con restricciones. Después lo hicimos con el <a href="/evidencias/proyecto/modelos">proyecto</a>.</p>
        </div>
      </section>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        <li><a href="https://es.wikipedia.org/wiki/ACID" target="_blank" rel="noopener">Wikipedia — ACID</a></li>
        <li><a href="https://es.wikipedia.org/wiki/Clave_candidata" target="_blank" rel="noopener">Wikipedia — Clave candidata</a></li>
      </ul>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 700px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  strong {
    color: var(--text-primary);
  }

  .lista-conceptos {
    color: var(--text-secondary);
    line-height: 1.8;
    padding-left: 1.25rem;
  }

  .lista-conceptos li {
    margin-bottom: 0.5rem;
  }

  .fuentes {
    color: var(--text-secondary);
    line-height: 1.9;
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }

  .img-doc {
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    margin: 1rem 0;
  }

  .bitacora {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-color);
  }

  .bitacora-fila {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .bitacora-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.2rem;
  }

  .bitacora-fila p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .bitacora-fila {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
  .definiciones {
    margin: 0;
    border-top: 1px solid var(--border-color);
  }

  .def {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.25rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .def dt {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.92rem;
  }

  .def dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .def {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>