---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

const pasos = [
  { num: '01', titulo: 'Eliminar multivaluados', desc: 'Cada atributo multivaluado pasa a ser una tabla aparte, con su clave y una FK hacia la entidad original.' },
  { num: '02', titulo: 'Transformar entidades', desc: 'Cada entidad se vuelve una tabla: sus atributos son las columnas y el atributo clave queda como PK.' },
  { num: '03', titulo: 'Relaciones según cardinalidad', desc: 'N:M crea una tabla nueva con las claves de las dos entidades. En 1:N la clave del lado 1 pasa como FK al lado N. En 1:1 depende de la participación.' },
  { num: '04', titulo: 'Revisar la participación', desc: 'Si una entidad tiene participación total y la otra parcial, la FK va en la tabla con participación total, para no dejar campos vacíos.' },
  { num: '05', titulo: 'Relaciones n-arias', desc: 'Cuando participan 3 o más entidades siempre se crea una tabla nueva con las claves de todas como FK.' },
  { num: '06', titulo: 'Roles', desc: 'Si una misma entidad participa dos veces en una relación, cada rol es una columna distinta con la misma FK repetida.' },
  { num: '07', titulo: 'Especialización', desc: 'Cada subtipo puede ser su propia tabla con la clave del padre, o todo puede ir en una sola tabla con un atributo que diga el tipo. Depende del caso.' },
  { num: '08', titulo: 'Revisión final', desc: 'Al terminar, cada tabla debe tener su PK bien definida y las FK deben coincidir con las cardinalidades del MER.' },
];
---

<BaseLayout title={'Transformación a tablas - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">
      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Modelado · 03</span>
      <h1>Transformación a tablas</h1>

      <p class="intro">
        Los pasos que sigo para pasar un modelo entidad-relación al modelo
        relacional, es decir, para convertirlo en tablas reales.
      </p>

      <div class="pasos">
        {pasos.map(p => (
          <div class="paso">
            <span class="paso-num">{p.num}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h2>Taller en clase</h2>
      <p>
        <a href="https://drive.google.com/file/d/1fxD4CiXxuO2MGfdzVm1OVv3Z3WuBRFMC/view?usp=sharing" target="_blank" rel="noopener">Ver el taller completo →</a>
      </p>
      <img src="/images/tallertablas.png" alt="Taller de transformación a tablas" class="img-doc" />

      <h2>Ejemplo 2</h2>
      <img src="/images/tablas2.png" alt="Ejemplo 2 de transformación a tablas" class="img-doc" />

      <section class="bitacora">
        <div class="bitacora-fila">
          <span class="bitacora-label">En clase</span>
          <p>El taller lo hicimos en grupo, con mis compañeros del proyecto. El ejemplo 2 también lo hicimos juntos, como repaso.</p>
        </div>
        <div class="bitacora-fila">
          <span class="bitacora-label">Lo que aprendí</span>
          <p>
            Lo que más me costó fueron las llaves foráneas: entender de qué lado
            quedan y cómo pasan de una tabla a otra. Los casos más complejos
            fueron la agregación y la especialización, porque en un caso el
            subtipo desaparece y en otro no, y cuando se parte hay que decidir
            cómo se reparten los atributos entre las tablas. Esto después lo
            usamos directo en el proyecto.
          </p>
        </div>
      </section>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        <li><a href="https://es.wikipedia.org/wiki/Modelo_relacional" target="_blank" rel="noopener">Wikipedia — Modelo relacional</a></li>
        <li><a href="https://es.wikipedia.org/wiki/Clave_foránea" target="_blank" rel="noopener">Wikipedia — Clave foránea</a></li>
      </ul>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 700px;
    padding: 1rem 0 3rem;
  }

    .img-doc {
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    margin: 1rem 0 2rem;
  }

  .doc a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .pasos {
    display: flex;
    flex-direction: column;
  }

  .paso {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .paso-num {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .paso h3 {
    font-size: 1rem;
    margin: 0 0 0.3rem;
    color: var(--text-primary);
  }

  .paso p {
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.55;
  }

  .placeholder-text {
    font-style: italic;
    color: var(--text-tertiary);
  }

  .img-placeholder {
    margin: 1.5rem 0 2rem;
    padding: 3rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 14px;
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .fuentes {
    color: var(--text-secondary);
    line-height: 1.9;
    padding-left: 1.25rem;
    font-size: 0.9rem;
  }

  .bitacora {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-color);
  }

  .bitacora-fila {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .bitacora-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.2rem;
  }

  .bitacora-fila p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .bitacora-fila {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>