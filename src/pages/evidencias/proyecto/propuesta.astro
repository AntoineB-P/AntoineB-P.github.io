---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';
---

<BaseLayout title={'Propuesta de proyecto - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">
      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Proyecto · Fase 1</span>
      <h1>Sistema de Gestión de Información para la Liga BetPlay</h1>
      <p class="meta">Integrantes: Felipe Sierra, Samuel Cubillos, Antoine Blanco</p>

      <h2>Problemática</h2>
      <p>
        Los datos de la Liga BetPlay (equipos, jugadores, partidos, árbitros,
        tarjetas) están repartidos entre medios y apps distintas, y un mismo
        dato puede cambiar según la fuente.
      </p>

      <h2>Objetivo</h2>
      <p>
        Diseñar e implementar una base de datos relacional para que una sola
        organización centralice esa información.
      </p>

      <h2>Objetivos específicos</h2>
      <ul class="lista-conceptos">
        <li>Modelar la liga con notación Chen.</li>
        <li>Normalizar hasta 3FN.</li>
        <li>Implementarla en un RDBMS distinto a SQL Server, en una VM con Linux.</li>
        <li>Consultarla con álgebra relacional y SQL.</li>
        <li>Hacer una app web de uso interno conectada a la base.</li>
        <li>Trabajar en GitHub con aportes de todo el equipo.</li>
      </ul>

      <h2>Alcance</h2>
      <p>
        Solo la Liga BetPlay, como herramienta interna. Fuera del alcance:
        boletería, transmisiones, pagos e integración con otras ligas.
      </p>

      <h2>Entidades principales</h2>
      <p class="entidades">
        Torneo · Equipo · Jugador · Técnico · Partido · Resultado · Árbitro ·
        Tarjeta · Tabla de posiciones
      </p>

      <h2>Requerimientos</h2>
      <ul class="lista-conceptos">
        <li>Registrar, consultar, editar y borrar equipos, jugadores, técnicos y árbitros.</li>
        <li>Programar partidos y registrar resultados y tarjetas.</li>
        <li>Generar la tabla de posiciones y las estadísticas de cada jugador.</li>
        <li>Consultar el historial de un equipo.</li>
      </ul>

      <p class="siguiente">
        Lo que vino después: <a href="/evidencias/proyecto/modelos">modelos</a>, <a href="/evidencias/proyecto/base-de-datos">base de datos</a>, <a href="/evidencias/proyecto/aplicacion">aplicación</a> y <a href="/evidencias/proyecto/bitacora">bitácora</a>.
      </p>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .meta {
    color: var(--text-tertiary);
    font-size: 0.88rem;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: 1.25rem;
    margin: 2rem 0 0.6rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  strong {
    color: var(--text-primary);
  }

  .lista-conceptos {
    color: var(--text-secondary);
    line-height: 1.8;
    padding-left: 1.25rem;
    font-size: 0.92rem;
  }

  .lista-conceptos li {
    margin-bottom: 0.5rem;
  }
  .entidades {
    font-size: 0.92rem;
    line-height: 1.9;
  }

  .siguiente {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.9rem;
  }
</style>