---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

type Etapa = {
  num: string;
  titulo: string;
  fecha: string;
  hicimos: string;
  problema?: string;
  aprendimos: string;
};

const etapas: Etapa[] = [
  {
    num: '01',
    titulo: 'Arranque',
    fecha: 'Oct 2026',
    hicimos: 'Propuesta, acta de constitución y supuestos. Repositorio en GitHub con una rama por integrante.',
    problema: 'Subíamos varias versiones del mismo documento y no sabíamos cuál era la última.',
    aprendimos: 'A trabajar con ramas y pull requests, y a dejar una sola versión de cada archivo.',
  },
  {
    num: '02',
    titulo: 'Modelado y normalización',
    fecha: 'Oct 2026',
    hicimos: 'MER, MER extendido con la especialización de JUGADOR, reducción a tablas y 3FN.',
    problema: 'La relación JUGAR repetía lo que ya guardaba PARTICIPACION. La quitamos.',
    aprendimos: 'Que el modelo cambia muchas veces, y cada cambio hay que llevarlo a todo lo demás.',
  },
  {
    num: '03',
    titulo: 'Máquina virtual y Oracle',
    fecha: 'Oct 2026',
    hicimos: 'Oracle Linux 9 en VirtualBox con Oracle AI Database Free. Usuario LIGA en FREEPDB1 y conexión desde SQL Developer.',
    problema: 'El scp fallaba (Connection refused), salía ORA-01034 y el puerto 1521 estaba cerrado. Se arregló con STARTUP, el firewall y el reenvío de puertos.',
    aprendimos: 'A leer los errores de Oracle en vez de reinstalar todo.',
  },
  {
    num: '04',
    titulo: 'Data Modeler',
    fecha: 'Oct – Nov 2026',
    hicimos: 'Modelo lógico, relacional e informe del diccionario de datos.',
    problema: 'La relación ROL–USUARIO estaba al revés: decía que un usuario podía no tener rol.',
    aprendimos: 'Que el modelo y la base tienen que decir exactamente lo mismo.',
  },
  {
    num: '05',
    titulo: 'Backend y aplicación',
    fecha: 'Oct – Nov 2026',
    hicimos: 'Backend en Spring Boot con JDBC y JWT. Frontend en Angular con panel de administrador.',
    problema: 'Algunos CHECK de la base chocaban con la app; esas validaciones pasaron al backend. También hubo que configurar CORS.',
    aprendimos: 'Que cada pantalla termina siendo una consulta con JOIN o GROUP BY.',
  },
  {
    num: '06',
    titulo: 'Datos y scripts',
    fecha: 'Nov 2026',
    hicimos: '20 equipos, 640 jugadores y 70 partidos del torneo II-2026, en tres scripts con su README.',
    problema: 'Al exportar, las fechas salieron con el año en dos dígitos: 1941 quedaba como 2041.',
    aprendimos: 'Que cargar datos reales cuesta más que crear las tablas, y hay que comprobarlos con consultas.',
  },
  {
    num: '07',
    titulo: 'Sustentación',
    fecha: 'Nov 2026',
    hicimos: 'Video y sustentación, el 18 de noviembre.',
    aprendimos: 'A explicar el proyecto completo, del MER a la app funcionando.',
  },
];
---

<BaseLayout title={'Bitácora del proyecto - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">

      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Proyecto · Fase 2</span>
      <h1>Bitácora del proyecto</h1>
      <p class="meta">Integrantes: Felipe Sierra, Samuel Cubillos, Antoine Blanco</p>

      <p class="intro">
        Lo que pasó después de la <a href="/evidencias/proyecto/propuesta">propuesta</a>,
        etapa por etapa.
      </p>

      <p class="herramientas">
        Oracle Linux · VirtualBox · Oracle AI Database Free · SQL Developer ·
        Data Modeler · draw.io · Spring Boot · Angular · GitHub
      </p>

      <div class="etapas">
        {etapas.map(e => (
          <section class="etapa">
            <span class="etapa-num">{e.num}</span>
            <div>
              <div class="etapa-header">
                <h2>{e.titulo}</h2>
                <span class="etapa-fecha">{e.fecha}</span>
              </div>
              <p><span class="etiqueta">Qué hicimos</span>{e.hicimos}</p>
              {e.problema && (
                <p><span class="etiqueta">Qué salió mal</span>{e.problema}</p>
              )}
              <p><span class="etiqueta">Qué aprendimos</span>{e.aprendimos}</p>
            </div>
          </section>
        ))}
      </div>

      <h2 class="cierre-titulo">Lo que nos llevamos</h2>
      <p class="cierre">
        Que todo se conecta: sin un buen MER no hay buenas tablas, y sin SQL la
        app no muestra nada. Y a trabajar en grupo con Git.
      </p>

    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin: 0 0 1.5rem;
  }

  .intro {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .herramientas {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    line-height: 1.7;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin: 0 0 1rem;
  }

  .etapas {
    display: flex;
    flex-direction: column;
  }

  .etapa {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .etapa-num {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .etapa-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .etapa-header h2 {
    font-size: 1.2rem;
    margin: 0;
  }

  .etapa-fecha {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .etapa p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }

  .etapa p:last-child {
    margin-bottom: 0;
  }

  .etiqueta {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.15rem;
  }

  .cierre-titulo {
    font-size: 1.2rem;
    margin: 2.5rem 0 0.6rem;
  }

  .cierre {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .etapa {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .etapa-header {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
