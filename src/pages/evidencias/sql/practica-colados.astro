---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

type Ejercicio = {
  enunciado: string;
  consulta: string;
  columnas: string[];
  filas: string[][];
  correccion?: string;
};

const tablas = [
  {
    nombre: 'ESTACION',
    columnas: ['ID_ESTACION', 'NOMBRE', 'ACTIVA', 'ID_TRONCAL'],
    filas: [
      ['10', 'Portal Norte', 'Si', '1'],
      ['11', 'Calle 100', 'Si', '1'],
      ['20', 'Portal Sur', 'Si', '2'],
      ['30', 'Calle 26', 'No', '3'],
    ],
  },
  {
    nombre: 'GUARDA',
    columnas: ['ID_GUARDA', 'NOMBRE', 'APELLIDO', 'TURNO', 'CARGO', 'ID_ESTACION', 'ID_SUPERVISOR'],
    filas: [
      ['1', 'Laura', 'Gómez', 'Mañana', 'Supervisor', '10', ''],
      ['2', 'Carlos', 'Ruiz', 'Noche', 'Guarda', '10', '1'],
      ['3', 'Ana', 'Torres', 'Tarde', 'Guarda', '20', '1'],
    ],
  },
  {
    nombre: 'MODALIDAD',
    columnas: ['ID_MODALIDAD', 'NOMBRE'],
    filas: [
      ['1', 'Salto de torniquete'],
      ['2', 'Puerta forzada'],
      ['3', 'Ingreso por salida'],
    ],
  },
  {
    nombre: 'EVENTO',
    columnas: ['ID_EVENTO', 'FECHA', 'HORA', 'NUMERO_PERSONAS', 'ID_ESTACION', 'ID_TARIFA', 'ID_MODALIDAD', 'ID_GUARDA'],
    filas: [
      ['1', '2026-11-09', '07:30', '3', '10', '2', '1', '2'],
      ['2', '2026-11-09', '18:10', '5', '11', '2', '2', '2'],
      ['3', '2026-11-10', '07:45', '2', '10', '2', '1', '1'],
      ['4', '2026-11-10', '17:50', '6', '20', '2', '3', '3'],
      ['5', '2025-12-20', '08:00', '4', '20', '1', '1', '3'],
      ['6', '2026-11-11', '06:55', '1', '10', '2', '2', '2'],
    ],
  },
];

const colados: Ejercicio[] = [
  {
    enunciado: '¿Cuál es el promedio de personas por evento?',
    consulta: `SELECT AVG(numero_personas)
FROM evento;`,
    columnas: ['AVG(NUMERO_PERSONAS)'],
    filas: [['3.5']],
  },
  {
    enunciado: '¿Cuántos guardas distintos registraron eventos en la estación 10?',
    consulta: `SELECT COUNT(DISTINCT id_guarda)
FROM evento
WHERE id_estacion = 10;`,
    columnas: ['COUNT(DISTINCTID_GUARDA)'],
    filas: [['2']],
    correccion: 'Al principio contábamos desde GUARDA, pero eso da los guardas asignados a la estación, no los que registraron eventos. Lo cambiamos a EVENTO.',
  },
  {
    enunciado: 'Las estaciones con más de 5 colados en total.',
    consulta: `SELECT id_estacion, SUM(numero_personas)
FROM evento
GROUP BY id_estacion
HAVING SUM(numero_personas) > 5;`,
    columnas: ['ID_ESTACION', 'SUM(NUMERO_PERSONAS)'],
    filas: [['10', '6'], ['20', '10']],
  },
  {
    enunciado: 'Total de colados por fecha, de la más antigua a la más reciente.',
    consulta: `SELECT SUM(numero_personas), fecha
FROM evento
GROUP BY fecha
ORDER BY fecha ASC;`,
    columnas: ['SUM(NUMERO_PERSONAS)', 'FECHA'],
    filas: [['4', '2025-12-20'], ['8', '2026-11-09'], ['8', '2026-11-10'], ['1', '2026-11-11']],
  },
  {
    enunciado: "Nombre y apellido de los guardas que registraron colados en 'Portal Norte', sin repetidos.",
    consulta: `SELECT DISTINCT g.nombre, g.apellido
FROM guarda g
JOIN evento e ON g.id_guarda = e.id_guarda
JOIN estacion es ON e.id_estacion = es.id_estacion
WHERE es.nombre = 'Portal Norte';`,
    columnas: ['NOMBRE', 'APELLIDO'],
    filas: [['Carlos', 'Ruiz'], ['Laura', 'Gómez']],
  },
  {
    enunciado: 'Cuántos eventos hay de cada modalidad, con el nombre de la modalidad.',
    consulta: `SELECT COUNT(e.id_evento), m.nombre
FROM evento e
JOIN modalidad m ON e.id_modalidad = m.id_modalidad
GROUP BY m.nombre;`,
    columnas: ['COUNT(E.ID_EVENTO)', 'NOMBRE'],
    filas: [['3', 'Salto de torniquete'], ['2', 'Puerta forzada'], ['1', 'Ingreso por salida']],
  },
];

const liga: Ejercicio[] = [
  {
    enunciado: 'Por cada ciudad, cuántos estadios tiene y su capacidad promedio, máxima y mínima.',
    consulta: `SELECT ciudad_estadio, COUNT(*) AS estadios,
       AVG(capacidad), MAX(capacidad), MIN(capacidad)
FROM estadio
GROUP BY ciudad_estadio
ORDER BY estadios DESC;`,
    columnas: ['CIUDAD_ESTADIO', 'ESTADIOS', 'AVG', 'MAX', 'MIN'],
    filas: [
      ['Barranquilla', '2', '36800', '65000', '8600'],
      ['Bogotá', '2', '23171.5', '36343', '10000'],
      ['Medellín', '2', '24500', '45000', '4000'],
      ['Bucaramanga', '1', '28000', '28000', '28000'],
    ],
  },
  {
    enunciado: 'Cuántos jugadores hay de cada nacionalidad, solo las que tengan más de 5.',
    consulta: `SELECT nacionalidad, COUNT(id_jugador) AS total_jugador
FROM jugador
GROUP BY nacionalidad
HAVING COUNT(id_jugador) > 5;`,
    columnas: ['NACIONALIDAD', 'TOTAL_JUGADOR'],
    filas: [['Colombia', '573'], ['Argentina', '26'], ['Uruguay', '11'], ['Venezuela', '9'], ['Ecuador', '6']],
    correccion: 'Escribimos HAVING TOTAL_JUGADOR > 5 y Oracle no lo acepta: en el HAVING no se puede usar el alias, hay que repetir el COUNT.',
  },
  {
    enunciado: 'Cada equipo con el nombre de su técnico y de su estadio sede.',
    consulta: `SELECT e.nombre_equipo, t.nombres, es.nombre_estadio
FROM equipo e
JOIN tecnico t ON t.id_tecnico = e.id_tecnico
JOIN estadio es ON es.id_estadio = e.id_sede
ORDER BY es.nombre_estadio;`,
    columnas: ['NOMBRE_EQUIPO', 'NOMBRES', 'NOMBRE_ESTADIO'],
    filas: [
      ['Atlético Bucaramanga', 'Pablo', 'Estadio Américo Montanini'],
      ['Alianza Valledupar', 'José Flabio', 'Estadio Armando Maestre Pavajeau'],
      ['Atlético Nacional', 'Lucas', 'Estadio Atanasio Girardot'],
      ['Independiente Medellín', 'Luis Amaranto', 'Estadio Atanasio Girardot'],
    ],
    correccion: 'Teníamos ORDER BY e.nombre_estadio, pero e es EQUIPO y esa columna está en ESTADIO. Se cambió a es.nombre_estadio.',
  },
  {
    enunciado: 'Todos los equipos y cuántos usuarios los tienen como favorito, incluidos los que tienen 0.',
    consulta: `SELECT e.nombre_equipo, COUNT(u.id_usuario) AS favoritos
FROM equipo e
LEFT JOIN usuario u ON u.id_equipo_favorito = e.id_equipo
GROUP BY e.nombre_equipo;`,
    columnas: [],
    filas: [],
  },
];

const grupos = [
  { titulo: 'Colados en TransMilenio', inicio: 1, ejercicios: colados },
  { titulo: 'Liga BetPlay', inicio: 7, ejercicios: liga },
];
---

<BaseLayout title={'Práctica de consultas - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="doc">

      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">SQL · Práctica</span>
      <h1>Práctica de consultas</h1>
      <p class="meta">Antoine Blanco y Susan Uriza</p>

      <p class="intro">
        10 consultas que resolvimos primero a mano en el cuaderno y después
        probamos en SQL Developer. Las 6 primeras son sobre un sistema de
        colados en TransMilenio y las otras 4 sobre la base de la <a href="/evidencias/sql/consultas-liga">Liga BetPlay</a>.
        Cada ejercicio tiene la foto de cómo lo escribimos, la consulta ya
        revisada y su resultado.
      </p>

      <a href="/documentos/practica-consultas.pdf" target="_blank" rel="noopener" class="documento">
        <span class="documento-tipo">PDF</span>
        <span>Ver la práctica completa, con las tablas y las fotos</span>
      </a>

      <h2>Tablas de los colados</h2>
      {tablas.map(t => (
        <div class="tabla-datos">
          <span class="tabla-nombre">{t.nombre}</span>
          <div class="resultado">
            <table>
              <thead><tr>{t.columnas.map(c => <th>{c}</th>)}</tr></thead>
              <tbody>{t.filas.map(f => <tr>{f.map(v => <td>{v}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </div>
      ))}
      <p class="nota">
        El modelo también tiene TRONCAL, TARIFA, INFRACTOR, COMPARENDO, PAGO y
        USUARIO, pero estas consultas no las usan.
      </p>

      {grupos.map(g => (
        <section>
          <h2>{g.titulo}</h2>
          <div class="ejercicios">
            {g.ejercicios.map((e, i) => (
              <div class="ejercicio">
                <span class="ejercicio-num">{String(g.inicio + i).padStart(2, '0')}</span>
                <div class="ejercicio-content">
                  <p class="enunciado">{e.enunciado}</p>
                  <details class="desplegable">
                  <summary>Ver consulta y resultado</summary>
                  <a href={`/images/cuaderno-sql-${g.inicio + i}.jpg`} target="_blank" rel="noopener" class="cuaderno">
                    <img src={`/images/cuaderno-sql-${g.inicio + i}.jpg`} alt={'Consulta ' + (g.inicio + i) + ' escrita en el cuaderno'} />
                    <span>Así la escribimos en el cuaderno</span>
                  </a>
                  <pre><code>{e.consulta}</code></pre>
                  {e.filas.length > 0 ? (
                    <div class="resultado">
                      <table>
                        <thead><tr>{e.columnas.map(c => <th>{c}</th>)}</tr></thead>
                        <tbody>{e.filas.map(f => <tr>{f.map(v => <td>{v}</td>)}</tr>)}</tbody>
                      </table>
                    </div>
                  ) : (
                    <p class="nota">El resultado depende de los usuarios que se registren en la aplicación.</p>
                  )}
                  {e.correccion && (
                    <p class="correccion"><span>Corregida</span>{e.correccion}</p>
                  )}
                  </details>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="bitacora">
        <div class="bitacora-fila">
          <span class="bitacora-label">En clase</span>
          <p>Lo hicimos en pareja, primero a mano y después probando en SQL Developer.</p>
        </div>
        <div class="bitacora-fila">
          <span class="bitacora-label">Lo que aprendí</span>
          <p>
            Al pasar las consultas del papel a SQL Developer salieron 3 errores
            que a mano no veíamos: contar desde la tabla equivocada, usar un alias
            en el HAVING y pedir una columna con el alias de otra tabla. Entendí
            que hay que fijarse bien de qué tabla sale cada columna y probar
            siempre la consulta, porque en el cuaderno todo parece correcto.
          </p>
        </div>
      </section>

    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    padding: 1rem 0 3rem;
  }

  .back-link {
    display: table;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin: 0 0 1.25rem;
  }

  h2 {
    font-size: 1.2rem;
    margin: 2.25rem 0 0.75rem;
  }

  .intro {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .tabla-datos {
    margin-bottom: 1.25rem;
  }

  .tabla-nombre {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .nota {
    font-size: 0.82rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  .ejercicios {
    display: flex;
    flex-direction: column;
  }

  .ejercicio {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .ejercicio-num {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .ejercicio-content {
    min-width: 0;
  }

  .enunciado {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  pre {
    margin: 0 0 0.75rem;
    padding: 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .resultado {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  th, td {
    text-align: left;
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  th {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .correccion {
    margin: 0.75rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-primary);
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .correccion span {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .bitacora {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-color);
  }

  .bitacora-fila {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .bitacora-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.2rem;
  }

  .bitacora-fila p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .ejercicio,
    .bitacora-fila {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  .desplegable summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.82rem;
    color: var(--text-tertiary);
    margin-top: 0.4rem;
  }

  .desplegable summary::-webkit-details-marker {
    display: none;
  }

  .desplegable summary::before {
    content: '▸ ';
  }

  .desplegable[open] summary::before {
    content: '▾ ';
  }

  .desplegable summary:hover {
    color: var(--color-primary);
  }

  .desplegable[open] summary {
    margin-bottom: 0.75rem;
  }
  .cuaderno {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--text-tertiary);
    font-size: 0.75rem;
  }

  .cuaderno img {
    display: block;
    width: 100%;
    max-width: 520px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    margin-bottom: 0.3rem;
  }

  .cuaderno:hover {
    color: var(--color-primary);
  }

  .documento {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .documento:hover {
    border-color: var(--color-primary);
  }

  .documento-tipo {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }
</style>
