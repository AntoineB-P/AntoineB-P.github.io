---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig } from '../../config';
---

<BaseLayout title={'Modelo entidad-relación - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <article class="trabajo">
      <a href="/evidencias" class="back-link">← Volver a Evidencias</a>

      <span class="eyebrow">Modelado</span>
      <h1>Modelo entidad-relación</h1>

      <p class="descripcion">
        Este es mi primer modelo entidad-relación, basado en un torneo de fútbol universitario.
      </p>

      <img
        src="/images/futbol.jpg"
        alt="Modelo entidad-relación de un torneo de fútbol universitario"
        class="imagen-trabajo"
      />
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .trabajo {
    max-width: 800px;
    padding: 2rem 0 3rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .trabajo h1 {
    font-size: 2.25rem;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .descripcion {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .imagen-trabajo {
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  @media (max-width: 600px) {
    .trabajo h1 {
      font-size: 1.75rem;
    }
  }
</style>