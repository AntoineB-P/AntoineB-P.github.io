---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';


const avance = 20;

const roadmap = [
  { label: 'Portafolio publicado', estado: 'done' },
  { label: 'Video de presentación', estado: 'done' },
  { label: 'Modelado', estado: 'pending' },
  { label: 'SQL', estado: 'pending' },
  { label: 'Proyecto final', estado: 'pending' },
];
---

<BaseLayout title={siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

 
    <section class="hero">
      <div class="hero-glow"></div>
      <img src="/images/portada.jpeg" alt="Antoine Blanco" class="cover" />
      <div class="hero-text">
        <span class="eyebrow">Portafolio académico · 2026</span>
        <h1>Antoine Blanco</h1>
        <p class="role">Ingeniería de Sistemas — Universidad El Bosque</p>
      </div>
    </section>

 
    <section class="bento">

      <!-- Progreso -->
      <div class="tile tile-progress">
        <div class="ring" style={`--p: ${avance}`}>
          <span>{avance}%</span>
        </div>
        <div>
          <p class="tile-title">Semestre en curso</p>
          <p class="tile-sub">Bases de Datos 1 · avance documentado</p>
        </div>
      </div>

      <a href="/presentacion" class="tile tile-link tile-orange">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
        <p class="tile-title">Presentación</p>
        <p class="tile-sub">Video y quién soy</p>
        <span class="tile-arrow">→</span>
      </a>

  
      <a href="/evidencias" class="tile tile-link tile-blue">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        <p class="tile-title">Trabajos</p>
        <p class="tile-sub">Evidencias del curso</p>
        <span class="tile-arrow">→</span>
      </a>

      <a href="/about" class="tile tile-link tile-purple">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <p class="tile-title">Sobre mí</p>
        <p class="tile-sub">Más contexto personal</p>
        <span class="tile-arrow">→</span>
      </a>


      <div class="tile tile-chips">
        <span class="chip">📍 Bogotá</span>
        <span class="chip">🎓 4to semestre</span>
        <span class="chip">🟢 En progreso</span>
      </div>

    </section>

    <section class="stepper">
      <h2 class="section-label">Ruta del semestre</h2>
      <div class="steps">
        {roadmap.map((r, i) => (
          <div class={`step ${r.estado}`}>
            <div class="step-dot">{r.estado === 'done' ? '✓' : i + 1}</div>
            <p>{r.label}</p>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }


  .hero {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0 3rem;
  }

  .hero-glow {
    position: absolute;
    top: -40px;
    left: -60px;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
    opacity: 0.18;
    filter: blur(30px);
    z-index: 0;
  }

  .cover {
    position: relative;
    z-index: 1;
    width: 130px;
    height: 130px;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 50%;
    border: 3px solid var(--bg-primary);
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }

  .hero-text {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
  }

  .role {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* BENTO */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 1rem;
  }

  .tile {
    border-radius: 20px;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .tile-progress {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
  }

  .tile-link {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: white;
    transition: transform 0.25s ease;
  }

  .tile-link:hover {
    transform: translateY(-4px);
  }

  .tile-orange { background: linear-gradient(135deg, #f97316, #ea580c); }
  .tile-blue { background: linear-gradient(135deg, #3b82f6, #2563eb); }
  .tile-purple { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }

  .tile-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 1.25rem;
    opacity: 0.7;
    transition: transform 0.25s ease;
  }

  .tile-link:hover .tile-arrow {
    transform: translateX(4px);
  }

  .tile-chips {
    grid-column: span 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    background: transparent;
    padding: 0;
  }

  .chip {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .tile-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .tile-sub {
    font-size: 0.85rem;
    opacity: 0.85;
    margin: 0;
  }

  .tile-progress .tile-title {
    color: var(--text-primary);
  }

  .tile-progress .tile-sub {
    color: var(--text-secondary);
  }

  /* RING */
  .ring {
    --p: 0;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: conic-gradient(var(--color-primary) calc(var(--p) * 1%), var(--bg-tertiary) 0);
  }

  .ring span {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  /* STEPPER */
  .section-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: 1.5rem;
  }

  .steps {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .step {
    flex: 1;
    text-align: center;
    position: relative;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 16px;
    left: -50%;
    width: 100%;
    height: 2px;
    background: var(--border-color);
    z-index: 0;
  }

  .step:first-child::before {
    display: none;
  }

  .step-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    margin: 0 auto 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    color: var(--text-tertiary);
    position: relative;
    z-index: 1;
  }

  .step.done .step-dot {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .step.done::before {
    background: var(--color-primary);
  }

  .step p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    padding: 0 0.5rem;
  }

  .step.done p {
    color: var(--text-primary);
    font-weight: 500;
  }

  /* RESPONSIVE */
  @media (max-width: 720px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }

    .bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .tile-progress {
      grid-column: span 2;
      grid-row: auto;
      flex-direction: column;
      text-align: center;
    }

    .tile-link {
      grid-column: span 2;
    }

    .steps {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .step::before {
      display: none;
    }

    .step {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-align: left;
    }

    .step-dot {
      margin: 0;
    }
  }
</style>