---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
---

<BaseLayout title={siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <section class="hero">
      <img src="/images/portada.jpeg" alt="Antoine Blanco" class="cover" />

      <div class="hero-text">
        <h1>{siteConfig.title}</h1>
        <p class="hero-description">
          {siteConfig.description}
        </p>

        <div class="hero-details">
          <p>
            Este es mi portafolio digital para la materia <strong>Bases de Datos 1</strong>,
            donde iré documentando todo el proceso del semestre: ejercicios, evidencias
            de clase y el avance del proyecto final.
          </p>
          <ul>
            <li><strong>¿Qué encontrarás aquí?</strong> Trabajos, ejercicios prácticos y avances organizados por tema.</li>
            <li><strong>¿Cómo está organizado?</strong> En la sección "Trabajos" vas a encontrar cada entrega, y en "Presentación" mi video de introducción.</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem 0 3rem;
  }

  .cover {
    width: 220px;
    height: 220px;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 50%;
    flex-shrink: 0;
    border: 3px solid var(--border-color);
  }

  .hero-text {
    flex: 1;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .hero-details p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .hero-details ul {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--text-secondary);
  }

  .hero-details li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }

    .hero-details ul {
      text-align: left;
    }
  }
</style>