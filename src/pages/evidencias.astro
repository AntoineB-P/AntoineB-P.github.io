---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

const categorias = [
  {
    num: '01',
    titulo: 'Modelado',
    desc: 'Diagramas entidad-relación y modelado conceptual de datos.',
    estado: 'pending',
    progreso: 0,
  },
  {
    num: '02',
    titulo: 'Normalización',
    desc: 'Ejercicios y proyectos de normalización (1FN, 2FN, 3FN).',
    estado: 'pending',
    progreso: 0,
  },
  {
    num: '03',
    titulo: 'SQL',
    desc: 'Consultas, scripts y ejercicios prácticos de SQL.',
    estado: 'pending',
    progreso: 0,
  },
  {
    num: '04',
    titulo: 'Proyecto',
    desc: 'Avances del proyecto final del curso.',
    estado: 'pending',
    progreso: 0,
  },
];
---

<BaseLayout title={'Trabajos - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

    <section class="page-hero">
      <span class="eyebrow">Bases de Datos 1 · Semestre 2026</span>
      <h1>Trabajos</h1>
      <p class="page-desc">
        Cada categoría documenta una parte del curso. Se irán llenando a medida
        que avance el semestre — por ahora, así arranca el mapa.
      </p>
    </section>

    <section class="categorias">
      {categorias.map(cat => (
        <div class="cat-row">
          <span class="cat-num">{cat.num}</span>

          <div class="cat-main">
            <div class="cat-heading">
              <h2>{cat.titulo}</h2>
              <span class={`cat-status ${cat.estado}`}>
                {cat.estado === 'pending' ? 'Próximamente' : 'En progreso'}
              </span>
            </div>
            <p class="cat-desc">{cat.desc}</p>

            <div class="progress-track">
              <div class="progress-fill" style={`width: ${cat.progreso}%`}></div>
            </div>
          </div>
        </div>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 1.5rem 0 3rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 3rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .page-hero h1 {
    font-size: 3rem;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 520px;
    line-height: 1.6;
  }

  .categorias {
    display: flex;
    flex-direction: column;
    padding-bottom: 3rem;
  }

  .cat-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .cat-num {
    font-size: 1rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }

  .cat-heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .cat-heading h2 {
    font-size: 1.75rem;
    margin: 0;
  }

  .cat-status {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px dashed var(--border-color);
    color: var(--text-tertiary);
  }

  .cat-status.active {
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
  }

  .cat-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 520px;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .progress-track {
    height: 4px;
    background: var(--bg-secondary);
    border-radius: 999px;
    overflow: hidden;
    max-width: 320px;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  @media (max-width: 640px) {
    .page-hero h1 {
      font-size: 2.25rem;
    }

    .cat-row {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
    }

    .cat-heading h2 {
      font-size: 1.4rem;
    }
  }
</style>