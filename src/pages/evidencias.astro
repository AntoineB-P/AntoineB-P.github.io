---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

// Para agregar contenido, llena el arreglo "items" de la categoría correspondiente:
// { titulo: 'Nombre del trabajo', fecha: 'Ago 2026', link: '/ruta-o-url' }

const categorias = [
  {
    key: 'modelado',
    titulo: 'Modelado',
    color: '#f97316',
    icon: '🧩',
    desc: 'Diagramas entidad-relación y modelado conceptual.',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'normalizacion',
    titulo: 'Normalización',
    color: '#3b82f6',
    icon: '🧮',
    desc: 'Ejercicios de 1FN, 2FN y 3FN.',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'sql',
    titulo: 'SQL',
    color: '#22c55e',
    icon: '🗄️',
    desc: 'Consultas y scripts prácticos.',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'proyecto',
    titulo: 'Proyecto',
    color: '#8b5cf6',
    icon: '🚀',
    desc: 'Avances del proyecto final.',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
];
---

<BaseLayout title={'Trabajos - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

    <section class="page-hero">
      <span class="eyebrow">Bases de Datos 1</span>
      <h1>Trabajos</h1>
      <p>Toca cada categoría para ver el contenido. Se irá llenando durante el semestre.</p>
    </section>

    <section class="accordion">
      {categorias.map((cat, i) => (
        <div class="acc-item" style={`--c: ${cat.color}`} data-index={i}>
          <button class="acc-trigger">
            <span class="acc-icon">{cat.icon}</span>
            <span class="acc-title">{cat.titulo}</span>
            <span class="acc-desc">{cat.desc}</span>
            <span class="acc-count">{cat.items.length}</span>
            <span class="acc-chevron">⌄</span>
          </button>

          <div class="acc-panel">
            <div class="acc-panel-inner">
              {cat.items.length === 0 ? (
                <p class="empty">Aún sin contenido — próximamente.</p>
              ) : (
                cat.items.map(item => (
                  <a href={item.link} class="item-row">
                    <span>{item.titulo}</span>
                    <span class="item-date">{item.fecha}</span>
                  </a>
                ))
              )}
            </div>
          </div>
        </div>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 1.5rem 0 2.5rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-hero h1 {
    font-size: 2.75rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .page-hero p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 3rem;
  }

  .acc-item {
    border-radius: 18px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    overflow: hidden;
  }

  .acc-trigger {
    width: 100%;
    display: grid;
    grid-template-columns: auto auto 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-primary);
    border-left: 4px solid var(--c);
  }

  .acc-icon {
    font-size: 1.5rem;
  }

  .acc-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .acc-desc {
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .acc-count {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--c);
    color: white;
    opacity: 0.85;
  }

  .acc-chevron {
    font-size: 1.1rem;
    color: var(--text-tertiary);
    transition: transform 0.25s ease;
  }

  .acc-item.open .acc-chevron {
    transform: rotate(180deg);
  }

  .acc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .acc-item.open .acc-panel {
    max-height: 500px;
  }

  .acc-panel-inner {
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .empty {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    padding: 1rem;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 10px;
    margin: 0;
  }

  .item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
  }

  .item-row:hover {
    border-color: var(--c);
  }

  .item-date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 640px) {
    .acc-trigger {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "icon title chevron"
        "icon desc chevron"
        "count count count";
      row-gap: 0.25rem;
    }

    .acc-icon { grid-area: icon; }
    .acc-title { grid-area: title; }
    .acc-desc { grid-area: desc; }
    .acc-chevron { grid-area: chevron; }
    .acc-count { grid-area: count; justify-self: start; margin-top: 0.35rem; }
  }
</style>

<script>
  function initAccordion() {
    document.querySelectorAll('.acc-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        trigger.closest('.acc-item')?.classList.toggle('open');
      });
    });
  }

  document.addEventListener('astro:page-load', initAccordion);
</script>