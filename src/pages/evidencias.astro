---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

const categorias = [
  { titulo: 'Modelado', desc: 'Diagramas entidad-relación y modelado de datos.' },
  { titulo: 'Normalización', desc: 'Ejercicios y proyectos de normalización (1FN, 2FN, 3FN).' },
  { titulo: 'SQL', desc: 'Consultas, scripts y ejercicios de SQL.' },
  { titulo: 'Proyecto', desc: 'Avances del proyecto final del curso.' },
];
---

<BaseLayout title={'Trabajos - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">
    <h1>Trabajos</h1>
    <p class="intro">
      Aquí voy a ir documentando cada entrega y ejercicio del semestre, organizados
      por tema. Por ahora las secciones están vacías, pero se irán llenando a medida
      que avance el curso.
    </p>

    <div class="grid">
      {categorias.map(cat => (
        <div class="card">
          <h2>{cat.titulo}</h2>
          <p>{cat.desc}</p>
          <span class="badge">Próximamente</span>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .intro {
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    padding-bottom: 3rem;
  }

  .card {
    padding: 2rem 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--bg-primary);
    border: 1px dashed var(--border-color);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
</style>