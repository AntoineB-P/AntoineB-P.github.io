---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

const categorias = [
  { num: '01', titulo: 'Modelado', items: [] as { titulo: string; fecha: string; link: string }[] },
  { num: '02', titulo: 'Normalización', items: [] as { titulo: string; fecha: string; link: string }[] },
  { num: '03', titulo: 'SQL', items: [] as { titulo: string; fecha: string; link: string }[] },
  { num: '04', titulo: 'Proyecto', items: [] as { titulo: string; fecha: string; link: string }[] },
];
---

<BaseLayout title={'Evidencias - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

    <section class="page-hero">
      <span class="eyebrow">Bases de Datos 1</span>
      <h1>Evidencias</h1>
      <p>El registro de trabajos y avances del semestre, organizado por tema.</p>
    </section>

    <section class="lista">
      {categorias.map(cat => (
        <div class="cat">
          <div class="cat-header">
            <span class="cat-num">{cat.num}</span>
            <h2>{cat.titulo}</h2>
            <span class="cat-count">{cat.items.length}</span>
          </div>

          <div class="cat-items">
            {cat.items.length === 0 ? (
              <p class="empty">Aún sin contenido — próximamente.</p>
            ) : (
              cat.items.map(item => (
                <a href={item.link} class="item-row">
                  <span>{item.titulo}</span>
                  <span class="item-date">{item.fecha}</span>
                </a>
              ))
            )}
          </div>
        </div>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 1.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-hero h1 {
    font-size: 2.75rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .page-hero p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .lista {
    display: flex;
    flex-direction: column;
    padding-bottom: 3rem;
  }

  .cat {
    border-bottom: 1px solid var(--border-color);
    padding: 1.5rem 0;
  }

  .cat-header {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
  }

  .cat-num {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .cat-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .cat-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  .cat-items {
    margin-top: 1rem;
    padding-left: calc(2.5rem + 1.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .empty {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: border-color 0.2s ease, padding-left 0.2s ease;
  }

  .item-row:hover {
    border-color: var(--color-primary);
    padding-left: 1.25rem;
  }

  .item-date {
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 600px) {
    .page-hero h1 {
      font-size: 2.1rem;
    }

    .cat-header {
      grid-template-columns: 2rem 1fr;
    }

    .cat-count {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.4rem;
    }

    .cat-items {
      padding-left: calc(2rem + 1.25rem);
    }
  }
</style>