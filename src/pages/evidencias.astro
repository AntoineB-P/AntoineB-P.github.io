---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';



const categorias = [
  {
    key: 'modelado',
    titulo: 'Modelado',
    color: 'orange',
    icon: '🧩',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'normalizacion',
    titulo: 'Normalización',
    color: 'blue',
    icon: '🧮',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'sql',
    titulo: 'SQL',
    color: 'green',
    icon: '🗄️',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
  {
    key: 'proyecto',
    titulo: 'Proyecto',
    color: 'purple',
    icon: '🚀',
    items: [] as { titulo: string; fecha: string; link: string }[],
  },
];
---

<BaseLayout title={'Trabajos - ' + siteConfig.title}>
  <Navigation />

  <main class="container" style="padding-top: 6rem;">

    <section class="page-hero">
      <span class="eyebrow">Bases de Datos 1</span>
      <h1>Trabajos</h1>
      <p>El mapa de evidencias del semestre, organizado por tema.</p>
    </section>

    <section class="categorias">
      {categorias.map(cat => (
        <div class={`cat cat-${cat.color}`}>
          <div class="cat-header">
            <span class="cat-icon">{cat.icon}</span>
            <h2>{cat.titulo}</h2>
            <span class="cat-count">{cat.items.length}</span>
          </div>

          <div class="cat-items">
            {cat.items.length === 0 ? (
              <div class="empty">Aún sin contenido — se irá llenando pronto</div>
            ) : (
              cat.items.map(item => (
                <a href={item.link} class="item-card">
                  <span class="item-title">{item.titulo}</span>
                  <span class="item-date">{item.fecha}</span>
                </a>
              ))
            )}
          </div>
        </div>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 1.5rem 0 2.5rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-hero h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .page-hero p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .categorias {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-bottom: 3rem;
  }

  .cat {
    border-radius: 20px;
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    position: relative;
    overflow: hidden;
  }

  .cat::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -20%;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    opacity: 0.15;
    filter: blur(10px);
  }

  .cat-orange::before { background: #f97316; }
  .cat-blue::before { background: #3b82f6; }
  .cat-green::before { background: #22c55e; }
  .cat-purple::before { background: #8b5cf6; }

  .cat-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .cat-icon {
    font-size: 1.5rem;
  }

  .cat-header h2 {
    font-size: 1.2rem;
    margin: 0;
    flex: 1;
  }

  .cat-count {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-tertiary);
  }

  .cat-items {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .empty {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 12px;
  }

  .item-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    color: var(--text-primary);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .item-card:hover {
    border-color: var(--color-primary);
    transform: translateX(3px);
  }

  .item-title {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .item-date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 720px) {
    .categorias {
      grid-template-columns: 1fr;
    }
  }
</style>